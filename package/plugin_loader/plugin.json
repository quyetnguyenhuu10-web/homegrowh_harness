{
  "id": "plugin-loader",
  "version": "0.1.0",
  "api_version": 1,
  "execution": {
    "mode": "module",
    "runtimes": [
      "node",
      "bun"
    ],
    "entry": "./dist/api.js"
  },
  "lifecycle": {
    "scope": "host"
  },
  "sandbox": {
    "enabled": false,
    "filesystem": [],
    "network": "none"
  },
  "references": [],
  "apis": [
    {
      "id": 1,
      "name": "get_error",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "output": {
        "type": "array",
        "items": { "$ref": "#/$defs/hh_error" },
        "$defs": {
          "hh_error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "operation", "type", "message", "data", "causes"],
            "properties": {
              "source": { "type": "string" },
              "operation": { "type": "string" },
              "type": { "type": "string" },
              "message": { "type": "string" },
              "data": { "type": "array", "items": true },
              "causes": { "type": "array", "items": { "$ref": "#/$defs/hh_error" } }
            }
          }
        }
      }
    }
  ],
  "data": {}
}
