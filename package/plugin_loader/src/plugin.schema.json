{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hh.local/schemas/plugin.schema.json",
  "title": "HH Plugin Manifest",
  "$comment": "HH JSON Schema extension: any API input/output schema may use x-hh-type. Supported values are uint64 and uint64-positive. The @hh/plugin-loader loader validates this keyword in addition to standard JSON Schema. For PluginHandle.call(name, ...args), input.required defines positional argument order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "api_version",
    "execution",
    "lifecycle",
    "sandbox",
    "references",
    "apis",
    "data"
  ],
  "$defs": {
    "api_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "x-hh-type": {
              "description": "HH integer extension understood by @hh/plugin-loader. uint64 accepts integer values from 0 through 18446744073709551615. uint64-positive accepts integer values from 1 through 18446744073709551615. JavaScript callers may use a safe integer number or bigint; values outside Number safe-integer range must use bigint.",
              "enum": [
                "uint64",
                "uint64-positive"
              ]
            }
          }
        },
        {
          "type": "boolean"
        }
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "integer",
      "minimum": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtimes",
        "entry"
      ],
      "properties": {
        "mode": {
          "const": "module"
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "node",
              "bun"
            ]
          }
        },
        "entry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "host",
            "session",
            "invocation"
          ]
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "filesystem",
        "network"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "access"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "enum": [
                  "read_only",
                  "read_write"
                ]
              }
            }
          }
        },
        "network": {
          "enum": [
            "none",
            "internet_client"
          ]
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "input",
          "output"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "$ref": "#/$defs/api_schema"
          },
          "output": {
            "$ref": "#/$defs/api_schema"
          }
        }
      }
    },
    "data": {
      "description": "Plugin-specific extension metadata. Use this for optional data understood by the plugin or specialized hosts but not required by the generic plugin framework."
    }
  }
}
