#pragma once

#include "../src/error/error.h"
#include <provider_types.generated.h>

#include <iosfwd>
#include <memory>
#include <functional>
#include <string>
#include <string_view>

#include <nlohmann/json.hpp>

namespace provider
{
    Result<Provider> provider_from_name(const std::string& provider_name);
    Result<std::optional<nlohmann::json>> usage_from_event(
        Provider provider, const nlohmann::json& event);
    Result<RequestUsage> parse_usage(
        Provider provider, const nlohmann::json& usage);

    using EventHandler = Result<void> (*)(void*, std::string&&);
    using FinishedHandler = Result<void> (*)(void*);

    struct EventSink
    {
        void* context = nullptr;
        EventHandler on_event = nullptr;
        FinishedHandler on_finished = nullptr;
    };

    Result<RequestUsage> request(
        Provider provider,
        const std::string& url,
        std::string_view api_key,
        const nlohmann::json& body,
        EventSink sink = {});

    struct CompactionResponse
    {
        RequestUsage usage = UsageState::unavailable;
    };

    struct CompactionResult
    {
        nlohmann::json messages;
        RequestUsage usage = UsageState::unavailable;
    };

    Result<CompactionResult> compaction(
        Provider selected_provider,
        const std::string& endpoint,
        const std::string& model_id,
        std::string_view api_key,
        std::string_view compaction_prompt,
        const nlohmann::json& session_current,
        const nlohmann::json& tool_definitions,
        const nlohmann::json& history = {},
        EventSink response_sink = {},
        bool compact = false,
        EventSink summary_sink = {},
        CompactionResponse* compaction_response = nullptr);

    class Stream
    {
    public:
        Stream(
            Provider provider,
            const std::string& url,
            const std::string& api_key,
            const nlohmann::json& body);

        ~Stream();

        Stream(const Stream&) = delete;
        Stream& operator=(const Stream&) = delete;

        Stream(Stream&&) noexcept;
        Stream& operator=(Stream&&) noexcept;

        Result<std::reference_wrapper<const RequestUsage>> usage() const;
        Result<void> write(std::ostream& output);
        const std::optional<Error>& error() const noexcept;

    private:
        struct Impl;
        std::unique_ptr<Impl> impl_;
        std::optional<Error> error_;
        bool moved_ = false;

        friend std::ostream& operator<<(std::ostream& output, Stream& stream);
    };

    std::ostream& operator<<(std::ostream& output, Stream& stream);
}
