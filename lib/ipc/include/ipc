#pragma once

#include <memory>
#include <cstdint>
#include <optional>
#include <span>
#include <string>
#include <vector>

#include <nlohmann/json.hpp>

namespace ipc
{
    struct Error
    {
        std::string source;
        std::string operation;
        std::string type;
        std::string message;
        nlohmann::json::array_t data;
        std::vector<Error> causes;
    };

    void to_json(nlohmann::json& json, const Error& error);

    class server;
    class connection;

    struct server_result;
    struct connection_result;
    struct write_result;
    struct read_result;

    class server final
    {
    public:
        server() noexcept;
        server(const server&) = delete;
        server& operator=(const server&) = delete;
        server(server&&) noexcept;
        server& operator=(server&&) noexcept;
        ~server();

    private:
        struct impl;

        explicit server(std::unique_ptr<impl>&& implementation) noexcept;

        std::unique_ptr<impl> impl_;

        friend server_result listen(const std::string& name);
        friend connection_result accept(server& listener);
    };

    class connection final
    {
    public:
        connection() noexcept;
        connection(const connection&) = delete;
        connection& operator=(const connection&) = delete;
        connection(connection&&) noexcept;
        connection& operator=(connection&&) noexcept;
        ~connection();

    private:
        struct impl;

        explicit connection(std::unique_ptr<impl>&& implementation) noexcept;

        std::unique_ptr<impl> impl_;

        friend connection_result accept(server& listener);
        friend connection_result connect(const std::string& name);
        friend write_result write(
            connection& target,
            std::span<const std::uint8_t> data);
        friend read_result read(connection& source);
    };

    struct server_result
    {
        server value;
        std::optional<Error> error;
    };

    struct connection_result
    {
        connection value;
        std::optional<Error> error;
    };

    struct write_result
    {
        std::optional<Error> error;
    };

    struct read_result
    {
        std::vector<std::uint8_t> data;
        bool closed = false;
        std::optional<Error> error;
    };

    // A result's value/data is authoritative only when error is nullopt.
    [[nodiscard]] server_result listen(const std::string& name);
    [[nodiscard]] connection_result accept(server& listener);
    [[nodiscard]] connection_result connect(const std::string& name);

    [[nodiscard]] write_result write(
        connection& target,
        std::span<const std::uint8_t> data);

    [[nodiscard]] read_result read(connection& source);
}
