{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hh.local/schemas/plugin.schema.json",
  "title": "HH Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "api_version",
    "execution",
    "lifecycle",
    "sandbox",
    "references",
    "apis",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "integer",
      "minimum": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime",
        "entry"
      ],
      "properties": {
        "mode": {
          "const": "module"
        },
        "runtime": {
          "const": "bun"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "host",
            "session",
            "invocation"
          ]
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "filesystem",
        "network"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "access"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "enum": [
                  "read_only",
                  "read_write"
                ]
              }
            }
          }
        },
        "network": {
          "enum": [
            "none",
            "internet_client"
          ]
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "input",
          "output"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "output": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    },
    "data": {
      "description": "Plugin-specific extension metadata. Use this for optional data understood by the plugin or specialized hosts but not required by the generic plugin framework."
    }
  }
}
